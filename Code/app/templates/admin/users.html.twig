{% extends 'base.html.twig' %}

{% block title %}Seznam uživatelů{% endblock %}

{% block body %}
    <div class="container my-5">
        <h1 class="mb-4">Seznam uživatelů</h1>

        <!-- Zobrazení flash zpráv -->
        {% for label, messages in app.flashes %}
            <div class="alert alert-{{ label }} alert-dismissible fade show" role="alert">
                {% for message in messages %}
                    {{ message }}
                {% endfor %}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Zavřít"></button>
            </div>
        {% endfor %}

        <table class="table table-striped table-hover">
            <thead class="table-light">
                <tr>
                    <th scope="col">#</th>
                    <th scope="col">Uživatelské jméno</th>
                    <th scope="col">Role</th>
                    <th scope="col">Datum registrace</th>
                    <th scope="col">Akce</th>
                </tr>
            </thead>
            <tbody>
                {% for user in users %}
                    <tr>
                        <th scope="row">{{ user.id }}</th>
                        <td>{{ user.username }}</td>
                        <td>
                            {% for role in user.roles %}
                                <span class="badge bg-primary">{{ role }}</span>
                            {% endfor %}
                        </td>
                        <td>{{ user.registeredAt ? user.registeredAt|date('d.m.Y H:i:s') : 'N/A' }}</td>
                        <td>
                            <form method="post" action="{{ path('admin_update_roles', { id: user.id }) }}">
                                <label for="roles-{{ user.id }}">Vyberte roli:</label>
                                <select name="roles[]" id="roles-{{ user.id }}" class="form-select">
                                    <option value="">Bez role</option>
                                    <option value="ROLE_ADMIN" {% if 'ROLE_ADMIN' in user.roles %}selected{% endif %}>ROLE_ADMIN</option>
                                    <option value="ROLE_AUTHOR" {% if 'ROLE_AUTHOR' in user.roles %}selected{% endif %}>ROLE_AUTHOR</option>
                                    <option value="ROLE_REDAKTOR" {% if 'ROLE_REDAKTOR' in user.roles %}selected{% endif %}>ROLE_REDAKTOR</option>
                                    <option value="ROLE_RECENZENT" {% if 'ROLE_RECENZENT' in user.roles %}selected{% endif %}>ROLE_RECENZENT</option>
                                </select>
                                <br><br>
                                <input type="submit" value="Uložit" class="btn btn-sm btn-success">
                            </form>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="5" class="text-center">Žádní uživatelé nebyli nalezeni.</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
